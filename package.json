{
  "name": "homigo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca WHATSAPP_MOCK_SEND=true SMS_MOCK_SEND=true RAZORPAY_MOCK_MODE=true next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "biome check",
    "format": "biome format --write",
    "setup:workers": "node scripts/setup-workers-env.mjs",
    "setup:admin": "node scripts/create-admin-user.mjs",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "test:workers": "node scripts/test-workers-api.mjs",
    "test:whatsapp": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-whatsapp-webhook.mjs",
    "test:whatsapp:booking": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-whatsapp-booking-flow.mjs",
    "test:whatsapp:routing": "node --experimental-strip-types scripts/test-whatsapp-routing.mjs",
    "test:whatsapp:fsm": "node --experimental-strip-types scripts/test-whatsapp-fsm.mjs",
    "test:conversation:inactivity": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-conversation-inactivity.mjs",
    "test:worker:matching": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-worker-matching.mjs",
    "seed:panvel:plumbers": "cross-env NODE_OPTIONS=--use-system-ca node scripts/seed-panvel-plumber-workers.mjs",
    "seed:homigo:booking": "cross-env NODE_OPTIONS=--use-system-ca node scripts/seed-homigo-booking-test-data.mjs",
    "test:booking:confirmation": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-booking-confirmation.mjs",
    "test:service:completion:payment": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-service-completion-payment-flow.mjs",
    "test:cash:completion": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-cash-payment-completion.mjs",
    "test:homigo:production": "cross-env NODE_OPTIONS=--use-system-ca SMS_MOCK_SEND=true RAZORPAY_MOCK_MODE=true WHATSAPP_MOCK_SEND=true node scripts/test-homigo-production.mjs",
    "test:worker:platform": "cross-env NODE_OPTIONS=--use-system-ca SMS_MOCK_SEND=true RAZORPAY_MOCK_MODE=true node scripts/test-worker-platform.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
