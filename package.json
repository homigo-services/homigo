{
  "name": "homigo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "biome check",
    "format": "biome format --write",
    "setup:workers": "node scripts/setup-workers-env.mjs",
    "verify:workers": "node scripts/verify-workers-setup.mjs",
    "test:workers": "node scripts/test-workers-api.mjs",
    "test:whatsapp": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-whatsapp-webhook.mjs",
    "test:whatsapp:booking": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-whatsapp-booking-flow.mjs",
    "test:whatsapp:routing": "node --experimental-strip-types scripts/test-whatsapp-routing.mjs",
    "test:worker:matching": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-worker-matching.mjs",
    "seed:panvel:plumbers": "cross-env NODE_OPTIONS=--use-system-ca node scripts/seed-panvel-plumber-workers.mjs",
    "test:booking:confirmation": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-booking-confirmation.mjs",
    "test:service:completion:payment": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-service-completion-payment-flow.mjs",
    "test:cash:completion": "cross-env NODE_OPTIONS=--use-system-ca node scripts/test-cash-payment-completion.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
